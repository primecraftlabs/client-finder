# Copy this file to .env and fill in your values. Never share .env with anyone.

# --- API keys ---
# Free key: https://aistudio.google.com -> Get API key
GEMINI_API_KEY=
# Google Cloud console -> enable "Places API (New)" -> Credentials -> API key
GOOGLE_PLACES_API_KEY=

# --- AI brain ---
# gemini (free tier) or ollama (runs on your own PC)
AI_PROVIDER=gemini
# "gemini-flash-latest" always points to the newest Flash model.
# Run "python -m leadagent models" to see which models your key can use.
GEMINI_MODEL=gemini-flash-latest
OLLAMA_MODEL=llama3.1
OLLAMA_URL=http://localhost:11434

# --- About you (used in the messages the AI writes) ---
YOUR_NAME=Jitender Kumar
BUSINESS_NAME=PrimeCraft Labs
YOUR_PORTFOLIO=https://primecraftlabs.github.io
YOUR_SERVICES=business websites, online booking systems, WhatsApp order buttons, Google Maps setup
# Rough prices so the AI never invents one. Leave empty and the AI will leave a [PRICE] gap for you.
PRICE_GUIDE=
# English, Hindi or Hinglish
MESSAGE_LANGUAGE=English

# --- Search settings ---
DEFAULT_CITY=Delhi
# Businesses with fewer reviews may be too small to pay; more than MAX are probably chains.
MIN_REVIEWS=15
MAX_REVIEWS=3000
# Safety limit so your WhatsApp number doesn't get flagged as spam
DAILY_SEND_LIMIT=20
